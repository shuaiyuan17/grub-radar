{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grub-radar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // The Cloudflare Vite plugin builds the SPA into dist/client and points the
  // output wrangler.json at it, so there is no assets.directory here.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // An explicit list: the Worker only runs for these paths, everything else
    // is a static file (or index.html) and never costs a Worker request.
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/authorize",
      "/.well-known/*",
      "/openapi.json",
      "/llms.txt",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grub-radar",
      "database_id": "d1e372b4-1215-48ba-bc07-5d908b8c9ea4",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    // GET /api/mapkit-token is public (the signed-out landing will need it), so it's braked per IP.
    {
      "name": "MAPKIT_TOKEN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "APPLE_TEAM_ID": "TMTJYK5V5B",
    "APPLE_CLIENT_ID": "me.shuaiyuan.grub.web",
    "APPLE_KEY_ID": "BQY23WRKNY",
    "PUBLIC_ORIGIN": "https://grub.shuaiyuan.me",
    // "false": only the very first account can be created (the owner); after that, sign-up is closed.
    // "true": anyone with an Apple ID can create an account.
    "SIGNUP_OPEN": "false",
  },
  // Secrets (wrangler secret put): APPLE_PRIVATE_KEY, SESSION_HMAC_KEY.
  "routes": [{ "pattern": "grub.shuaiyuan.me", "custom_domain": true }],
}
