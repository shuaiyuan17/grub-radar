{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grub-radar",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  // Outbound fetches never take same-zone shortcuts: required for the OAuth server to fetch a
  // client's Client ID Metadata Document safely (SSRF protection), see worker/agents/oauth.ts.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "upload_source_maps": true,
  "observability": { "enabled": true },
  // The Cloudflare Vite plugin builds the SPA into dist/client and points the
  // output wrangler.json at it, so there is no assets.directory here.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // An explicit list: the Worker only runs for these paths, everything else
    // is a static file (or index.html) and never costs a Worker request.
    "run_worker_first": [
      "/api/*",
      "/auth/*",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/authorize",
      "/.well-known/*",
      "/openapi.json",
      "/llms.txt",
      "/agent-setup.md",
      // the legal pages: server-rendered, readable signed out and without JS
      "/privacy",
      "/privacy/",
      "/terms",
      "/terms/",
    ],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grub-radar-db2",
      "database_id": "ba2155c4-be8d-4531-af15-20451f96c79e",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    // GET /api/mapkit-token, per user (MapKit asks again only when its 10-minute token expires).
    {
      "name": "MAPKIT_TOKEN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 },
    },
    // Writes to your list and home (add, edit, been, notes, delete), per user: a brake, not accounting.
    {
      "name": "WRITE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 },
    },
    // Apple Maps searches and place lookups, per user. Apple allows 25,000 calls a day for
    // the whole app; this keeps one person (or a runaway client) from spending it.
    {
      "name": "SEARCH_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 },
    },
    // Photo uploads, per user, on top of WRITE_LIMITER: each one is up to 1 MB into R2.
    {
      "name": "PHOTO_UPLOAD_LIMITER",
      "namespace_id": "1004",
      "simple": { "limit": 20, "period": 60 },
    },
    // Apple's form_post (POST /auth/callback), per client IP: anyone can make a browser POST
    // there, and a valid-looking one costs a decrypt and, with a code, a D1 write.
    {
      "name": "CALLBACK_LIMITER",
      "namespace_id": "1005",
      "simple": { "limit": 30, "period": 60 },
    },
    // Every request an agent makes (MCP at /mcp, REST with a personal token or OAuth token),
    // per credential, on top of the write and search brakes above.
    {
      "name": "AGENT_LIMITER",
      "namespace_id": "1006",
      "simple": { "limit": 120, "period": 60 },
    },
    // The OAuth server (/authorize, /oauth/token, /oauth/register), per client IP.
    {
      "name": "OAUTH_LIMITER",
      "namespace_id": "1007",
      "simple": { "limit": 30, "period": 60 },
    },
    // Bad bearer tokens (unknown, malformed, revoked), per client IP: past this, that IP's
    // tokens aren't looked up for a minute, so junk can't spend KV reads (worker/agents/oauth.ts).
    {
      "name": "BEARER_FAIL_LIMITER",
      "namespace_id": "1008",
      "simple": { "limit": 20, "period": 60 },
    },
  ],
  // The OAuth server's own store (workers-oauth-provider): agent clients, grants and tokens, all
  // hashed or encrypted by the library. Nothing else goes here: KV allows 1,000 writes a day.
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "f244df2d3e084470ae3ab08a2826e365" }],
  // Photo bytes. Private bucket: no public access, no r2.dev URL, no custom domain. The Worker
  // serves every photo at /api/photos/:id after checking who's asking (worker/routes/photos.ts).
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "grub-radar-photos" }],
  // Hourly: delete photo bytes still on the deletion outbox (photo_deletions), see worker/index.ts.
  "triggers": { "crons": ["23 * * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "APPLE_TEAM_ID": "TMTJYK5V5B",
    "APPLE_CLIENT_ID": "me.shuaiyuan.grub.web",
    "APPLE_KEY_ID": "BQY23WRKNY",
    "PUBLIC_ORIGIN": "https://grub.shuaiyuan.me",
    // "true" (launch, owner's call 10/14): anyone with an Apple ID can create an account.
    // "false": sign-up is closed. Exactly one account can still be created: the first one, or,
    // when the OWNER_APPLE_SUB secret is set, only that Apple ID. Admission is atomic in SQL.
    "SIGNUP_OPEN": "true",
  },
  // Secrets (wrangler secret put): APPLE_PRIVATE_KEY, SESSION_HMAC_KEY, optionally OWNER_APPLE_SUB,
  // and ADMIN_APPLE_SUBS (comma-separated Apple subs allowed on /admin; unset = nobody).
  // A secret, not a var: it names the owner's Apple ID, which stays out of the repo.
  // APPLE_PRIVATE_KEY (key BQY23WRKNY) signs Sign in with Apple client secrets, MapKit JS tokens
  // and the Maps Server API token (place search): the key has both services enabled.
  "routes": [{ "pattern": "grub.shuaiyuan.me", "custom_domain": true }],
  // No *.workers.dev URL and no per-version preview URLs: they'd run against the
  // production D1 and secrets. Previews come later, with their own database.
  "workers_dev": false,
  "preview_urls": false,
}
