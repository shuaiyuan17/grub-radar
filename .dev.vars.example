# Local-only Worker vars and secrets. Copy to .dev.vars (gitignored), or run
# `npm run dev:vars` to generate one with fresh random values.
# Never deployed: production secrets are set with `wrangler secret put`.

# Exactly "development" enables the dev-only features below (dev login, the Apple stub,
# request-origin redirects). Any other value behaves like production.
ENVIRONMENT=development

# HMAC key for the Sign in with Apple state cookie. 32+ random bytes, base64url.
SESSION_HMAC_KEY=change-me

# Apple ES256 .p8 key (PEM). `npm run dev:vars -- --from-keychain` pulls the real one;
# without it a throwaway P-256 key is generated (fine with the Apple stub).
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Apple only redirects to https://grub.shuaiyuan.me, so locally Sign in with Apple talks to a
# stub (`npm run apple-stub`, e2e/apple-stub.ts). Ignored unless ENVIRONMENT=development.
APPLE_ENDPOINT_BASE=http://localhost:4599

# The same stub stands in for the Apple Maps Server API (place search). Comment this out to
# search the real Apple Maps locally (needs the real key: `npm run dev:vars -- --from-keychain`).
# Ignored unless ENVIRONMENT=development.
APPLE_MAPS_BASE=http://localhost:4599

# Enables POST /auth/dev-login (development + localhost only). Playwright uses it.
DEV_LOGIN_SECRET=change-me

# Locally anyone can sign up.
SIGNUP_OPEN=true

# Apple subs that may open /admin (comma-separated). Locally: the dev user signed in with
# POST /auth/dev-login {"as":"admin"} (its stand-in identity is 'dev-login-admin').
# In production this is a secret (wrangler secret put ADMIN_APPLE_SUBS).
ADMIN_APPLE_SUBS=dev-login-admin
