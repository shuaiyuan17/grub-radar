{
  "name": "grub-radar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "deploy": "npm run build && npm run deploy:built",
    "deploy:built": "wrangler d1 migrations apply DB --remote -c dist/grub_radar/wrangler.json && wrangler deploy -c dist/grub_radar/wrangler.json",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run --outdir dist-worker -c dist/grub_radar/wrangler.json",
    "preview": "vite preview",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "dev:vars": "node scripts/dev-vars.mjs",
    "apple-stub": "node e2e/apple-stub.ts",
    "og-image": "node scripts/og-image.ts",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/long-cang": "^5.3.0",
    "@fontsource/shantell-sans": "^5.3.0",
    "@fontsource/zcool-kuaile": "^5.3.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "agents": "^0.28.1",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/vitest-plugin": "^1.4.2",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "^4.151.0"
  },
  "allowScripts": {
    "workerd@1.20261012.1": true,
    "esbuild@0.28.2": true
  }
}
